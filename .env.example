# Application Environment Variables Template (JanSeva / DIGIT CMS)

# Node Backend Service Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# PostgreSQL Relational Database
DATABASE_URL=postgresql://janseva_admin:janseva_password@localhost:5432/janseva_db
POSTGRES_USER=janseva_admin
POSTGRES_PASSWORD=janseva_password
POSTGRES_DB=janseva_db
POSTGRES_HOST=database
POSTGRES_PORT=5432

# Hyperledger Fabric 2-Org Gateway Credentials
FABRIC_CHANNEL_NAME=grievancechannel
FABRIC_CHAINCODE_NAME=grievance-cc
FABRIC_MSPID_PORTAL=PortalOrgMSP
FABRIC_MSPID_GOV=GovOrgMSP
FABRIC_PEER_ENDPOINT=localhost:7051

# IPFS Kubo Storage Node
IPFS_NODE_URL=http://localhost:5001
IPFS_GATEWAY_URL=http://localhost:8080

# SLA SLA Compliance Limits
SLA_URGENT_HOURS=24
SLA_HIGH_HOURS=48
SLA_MEDIUM_HOURS=72
SLA_LOW_HOURS=168
